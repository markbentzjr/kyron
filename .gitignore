# Build outputs and local toolchain (see app/fetch_deps.sh and docs)
*.apk
*.idsig
*.keystore
app/work/
app/deps/
build/
.gradle/
local.properties

# Bundled dataset snapshot: a minimal cleaned JCDH snapshot IS committed
# (places_seed_geocoded.json) so release APKs always carry Alabama data.
# A fuller regenerated snapshot (harvest/adph_harvest.py + jcdh_enum.py +
# mchd_harvest.py, then build_seed.py) can overwrite it locally.
app/src/main/assets/places_seed.json

# Harvest intermediates (regenerable with harvest/*.py)
harvest/adph/
harvest/*.html
harvest/*.log
harvest/mchd_rows.json
harvest/jcdh_enum*.json
__pycache__/

# Socrata city/county harvest outputs + packs (regenerate with harvest/socrata_cities)
harvest/socrata_cities/out/

# Generic-platform harvest raw caches + packs (regenerate with harvest/mhd, sfi, dhd)
harvest/mhd/raw/
harvest/mhd/out/
harvest/mhd/work/
harvest/sfi/raw/
harvest/sfi/out/
harvest/sfi/work/
harvest/dhd/raw/
harvest/dhd/out/
harvest/dhd/work/
harvest/snhd/raw/
harvest/snhd/out/
harvest/_release/
_verify/
dist/

# Built pack artifacts — regenerable via tools/packs; published to the
# data-packs GitHub release, never committed.
*.db.gz
/kyron-keys/
.kotlin/
harvest/ms/raw/
harvest/ms/out/
harvest/ms/work/
*.crash.log
