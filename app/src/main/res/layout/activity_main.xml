<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header bar (classic): title + the LF-4 region chip. The chip is
         a plain Button — LF-4's entry point into Coverage, unchanged. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kyron_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kyron"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Region chip (LF-4): shows the active region everywhere; tapping
             it opens Coverage, where states are picked/downloaded. The chip
             follows RegionManager, so a switch made in Coverage lands here. -->
        <Button
            android:id="@+id/region_chip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Alabama"
            android:textAllCaps="false"
            android:textColor="@color/kyron_dark" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- Tab bar (classic): the pre-2.1 navigation — four labeled tabs.
         Selected state (bold + brand color) is applied by MainActivity. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_browse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_search"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_browse"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_map"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_map"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_star_border"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_favorites"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_alerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_notifications"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_alerts"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
