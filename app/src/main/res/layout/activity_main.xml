<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header bar (classic): title + the LF-4 region chip. The chip is
         a plain Button — LF-4's entry point into Coverage, unchanged. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kyron_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Region chip (LF-4): shows the active region everywhere; tapping
             it opens Coverage, where states are picked/downloaded. The chip
             follows RegionManager, so a switch made in Coverage lands here. -->
        <Button
            android:stateListAnimator="@animator/press_scale"
            android:id="@+id/region_chip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:background="@drawable/status_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/region_chip_default"
            android:textAllCaps="false"
            android:textColor="@color/kyron_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Floating dock: the four tabs float above the content on a
         rounded, elevated pill instead of a full-width bar. Selection
         state (bold + brand color) is applied by MainActivity. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/dock_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/tab_pill"
            android:drawableTop="@drawable/ic_home"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_home"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_browse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/tab_pill"
            android:drawableTop="@drawable/ic_search"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_browse"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/tab_pill"
            android:drawableTop="@drawable/ic_map"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_map"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_alerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/tab_pill"
            android:drawableTop="@drawable/ic_person"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/nav_account"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
