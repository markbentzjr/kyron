<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Status line: what is on the map, and the honesty note that every
         pin is a verified address location (LF-1). Compact floating pill. -->
    <TextView
        android:id="@+id/map_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/status_pill"
        android:elevation="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:drawableStart="@drawable/ic_dot_green"
        android:drawablePadding="8dp"
        android:textAlignment="center"
        android:textColor="@color/ink_soft"
        android:textSize="12sp" />

    <!-- Empty-state card: only appears when the viewport truly has zero
         pins. It either flies you to where the region's data is, or
         honestly offers the Browse list for unmapped regions. -->
    <LinearLayout
        android:id="@+id/map_empty_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="48dp"
        android:background="@drawable/card_bg"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/chip_off_bg"
            android:padding="9dp"
            android:src="@drawable/ic_map"
            app:tint="@color/kyron_primary" />

        <TextView
            android:id="@+id/map_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <Button
            android:id="@+id/map_empty_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@animator/press_scale"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/map_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="#66FFFFFF"
        android:padding="2dp"
        android:text="@string/map_attribution"
        android:textColor="@color/muted"
        android:textSize="10sp" />

    <!-- Floating control column: zoom in / out / my-area. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/map_zoom_in"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fab_circle"
            android:contentDescription="@string/cd_zoom_in"
            android:elevation="6dp"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            android:stateListAnimator="@animator/press_scale" />

        <ImageButton
            android:id="@+id/map_zoom_out"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/fab_circle"
            android:contentDescription="@string/cd_zoom_out"
            android:elevation="6dp"
            android:padding="10dp"
            android:src="@drawable/ic_remove"
            android:stateListAnimator="@animator/press_scale" />

        <ImageButton
            android:id="@+id/map_locate"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fab_circle"
            android:contentDescription="@string/cd_my_location"
            android:elevation="8dp"
            android:padding="12dp"
            android:src="@drawable/ic_crosshair"
            android:stateListAnimator="@animator/press_scale" />
    </LinearLayout>

    <!-- Bottom-sheet place card (Presentation Spec 4.1, Peek state).
         One tap on a pin opens this card; "Full details" hands off to
         the place page. -->
    <LinearLayout
        android:id="@+id/place_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/card_bg"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <!-- Wide invisible drag target wrapping the visible pill handle. -->
        <FrameLayout
            android:id="@+id/sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="42dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/score_chip"
                android:backgroundTint="@color/line" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheet_badge"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sheet_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/sheet_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close_card"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawableStart="@drawable/ic_pin_small"
            android:drawablePadding="6dp"
            android:drawableTint="@color/muted"
            android:gravity="center_vertical"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sheet_why"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/chip_off_bg"
            android:drawableStart="@drawable/ic_info_small"
            android:drawablePadding="6dp"
            android:drawableTint="@color/muted"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:textColor="@color/ink_soft"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:textAllCaps="false"
                android:stateListAnimator="@animator/press_scale"
                android:id="@+id/sheet_open"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:textColor="@color/white"
                android:text="@string/action_full_details" />

            <Button
                android:textAllCaps="false"
                android:stateListAnimator="@animator/press_scale"
                android:id="@+id/sheet_fav"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_ghost"
                android:textColor="@color/kyron_primary"
                android:drawablePadding="6dp"
                android:text="@string/action_watch" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
